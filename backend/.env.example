# Google Gemini API Key (Get from Google AI Studio - Free tier)
GEMINI_API_KEY=your_gemini_api_key_here

# Default TTS Voice: th-TH-PremwadeeNeural (Female) or th-TH-NiwatNeural (Male)
DEFAULT_VOICE=th-TH-PremwadeeNeural

# Default TTS Speech Rate (e.g. +0%, +5%, +10%, +15%)
DEFAULT_RATE=+5%

# Server Port
PORT=8000
HOST=0.0.0.0

# Cache Database Path
SQLITE_CACHE_DB=dub_cache.db
